# RAWG API key, used as the cover-art fallback for games without an eShop listing.
RAWG_API_KEY=

# Optional: higher GitHub API rate limit for catalog builds (60 req/hour without it).
# GITHUB_TOKEN=

# Optional: only needed when hosting somewhere other than the default GitHub Pages URL.
# Path the app is served from (default: /nso-icon-creator/). Use / for a domain root.
# BASE_PATH=/
# Absolute public URL, used for the canonical link, social tags and sitemap.xml
# (default: https://harissabil.github.io/nso-icon-creator/).
# SITE_URL=https://example.com/
